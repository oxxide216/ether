(macro and (a b)
  (if a
    b
   else
    false))

(macro or (a b)
  (if a
    true
   else
    b))

(fun map (f l)
  (if (is-empty l)
    []
   else
    (prep (f (head l)) (map f (tail l)))))

(fun filter (p l)
  (if (is-empty l)
    []
   elif (p (head l))
    (prep (head l) (filter p (tail l)))
   else
    (filter p (tail l))))

(fun fold (f acc l)
  (if (is-empty l)
    acc
   else
    (fold f (f acc (head l)) (tail l))))

(fun zip (l0 l1)
  (if (or (is-empty l0) (is-empty l1))
    []
   else
    (prep [(head l0) (head l1)] (zip (tail l0) (tail l1)))))

; TODO: slice

(fun nth (l n)
  (if (= n 0)
    (head l)
   elif (< n 0)
    (nth l (+ (len l) n))
   else
    (nth (tail l) (- n 1))))

(fun range (b e)
  (if (= b e)
    []
   elif (< b e)
    (prep b (range (+ b 1) e))
   else
    (prep b (range (- b 1) e))))
