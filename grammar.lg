whitespace=( |\t|\r)*
newline=\n
comment=;

fun=fun
let=let
if=if
elif=elif
else=else
macro=macro
set=set
use=use
ret=ret
do=do

plus=\+
minus=\-
star=\*
slash=/
perc=%
oparen=\(
cparen=\)
ocurly=[
ccurly=]
str="|'
fstr=f("|')
unpack=...

int=\-?0-9+
float=\-?0-9+.0-9+
bool=true|false
ident=(a-z|A-Z|_|\-)(a-z|A-Z|_|\-|0-9)*
